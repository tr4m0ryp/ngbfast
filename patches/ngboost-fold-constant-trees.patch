@@ -16,6 +18,28 @@ from ngboost.manifold import manifold
 from ngboost.scores import LogScore
 
 
+class NGBoostDegenerateWarning(UserWarning):
+    """Every base learner of a fitted model is constant: it predicts one distribution for all inputs."""
+
+
+def _constant_tree_value(learner):
+    """The output of a single-output regression tree whose leaves all hold the same value, else None."""
+    tree = getattr(learner, "tree_", None)
+    if (
+        not isinstance(learner, DecisionTreeRegressor)
+        or tree is None
+        or getattr(learner, "n_outputs_", 1) != 1
+    ):
+        return None
+    values = np.ascontiguousarray(
+        tree.value[tree.children_left == -1].reshape(-1), dtype=np.float64
+    )
+    bits = values.view(np.uint64)
+    if not (bits == bits[0]).all():  # bitwise, so 0.0 and -0.0 leaves do not count as equal
+        return None
+    return learner.predict(np.zeros((1, learner.n_features_in_)))[0]
+
+
