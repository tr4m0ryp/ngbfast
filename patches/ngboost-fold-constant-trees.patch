+    def fold_constant_learners(self):
+        """
+        Precompute the contribution of every base learner that predicts the same value for every
+        input (a tree with a single node, or whose leaves all agree), so that pred_param calls only
+        the learners that depend on the input.
+
+        For each distribution parameter, the updates before its first input-dependent learner are
+        subtracted from the initial parameters once; later constant updates stay as scalar steps
+        between the evaluated learners, in round order. Every parameter therefore goes through the
+        same floating-point operations in the same order as the boosting loop, and pred_param returns
+        bit-identical results. fit and partial_fit call this at the end; call it again after editing
+        base_models, scalings or init_params by hand. Models whose base learners are not all
+        scikit-learn regression trees keep the loop.
+
+        Output:
+            The number of constant learners.
+        """
+        self.fold_ = None
+        n_params = self.Manifold.n_params
+        if not all(
+            isinstance(learner, DecisionTreeRegressor)
+            for models in self.base_models
+            for learner in models
+        ):
+            return 0
+        start = np.ones(n_params) * self.init_params
+        split_seen = np.zeros(n_params, dtype=bool)
+        steps, n_constant, cols = [], 0, set()
+        for i, (models, s, col_idx) in enumerate(
+            zip(self.base_models, self.scalings, self.col_idxs)
+        ):
+            cols.update(int(c) for c in col_idx)
+            for k, learner in enumerate(models):
+                value = _constant_tree_value(learner)
+                if value is None:
+                    split_seen[k] = True
+                    steps.append((i, k, None))
+                    continue
+                n_constant += 1
+                step = self.learning_rate * value * s  # the loop's update for this column
+                if split_seen[k]:
+                    steps.append((i, k, step))
+                else:
+                    start[k] -= step
+        self.fold_ = (start, steps, np.array(sorted(cols), dtype=np.intp))
+        return n_constant
+
+    def _pred_param_folded(self, X, fold):
+        start, steps, cols = fold
+        if cols.size and X.shape[1] <= cols[-1]:
+            raise ValueError(
+                f"X has {X.shape[1]} features, but the model's learners read column {cols[-1]}"
+            )
+        # One input check for all learners, the same as each tree's own (float32, NaN allowed).
+        check_array(
+            X[:, cols], accept_sparse=True, dtype=np.float32, ensure_all_finite="allow-nan"
+        )
+        params = np.ones((X.shape[0], self.Manifold.n_params)) * start
+        last, X_i = None, None
+        for i, k, step in steps:
+            if step is None:
+                if i != last:
+                    last, X_i = i, X[:, self.col_idxs[i]]
+                pred = self.base_models[i][k].predict(X_i)
+                params[:, k] -= self.learning_rate * pred * self.scalings[i]
+            else:
+                params[:, k] -= step
+        return params
+
     def sample(self, X, Y, sample_weight, params):
         idxs = np.arange(len(Y))
         col_idx = np.arange(X.shape[1])
@@ -336,6 +433,7 @@ class NGBoost:
