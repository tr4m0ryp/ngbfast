diff --git a/tests/test_fold.py b/tests/test_fold.py
new file mode 100644
index 0000000..9527ce7
--- /dev/null
+++ b/tests/test_fold.py
@@ -0,0 +1,172 @@
+"""Constant base learners are folded at the end of fit; pred_param stays bit-identical to the loop."""
+
+import pickle
+import time
+import warnings
+
+import numpy as np
+import pytest
+from numpy.testing import assert_array_equal
+from sklearn.tree import DecisionTreeRegressor
+
+from ngboost import NGBClassifier, NGBoost, NGBRegressor
+from ngboost.distns import Bernoulli, Normal, T, k_categorical
+from ngboost.ngboost import NGBoostDegenerateWarning
+from ngboost.scores import LogScore
+
+
+def _loop(m, X, max_iter=None):
+    """The boosting loop pred_param ran before folding: the reference every fold must reproduce."""
+    params = np.ones((X.shape[0], m.Manifold.n_params)) * m.init_params
+    for i, (models, s, col_idx) in enumerate(zip(m.base_models, m.scalings, m.col_idxs)):
+        if max_iter and i == max_iter:
+            break
+        resids = np.array([model.predict(X[:, col_idx]) for model in models]).T
+        params -= m.learning_rate * resids * s
+    return params
+
+
+def _bitwise(a, b):
+    assert_array_equal(np.asarray(a, np.float64).view(np.uint64), np.asarray(b, np.float64).view(np.uint64))
+
+
+def _toy(n=300, seed=0):
+    rng = np.random.RandomState(seed)
+    X = rng.normal(size=(n, 4))
+    Y = 1.5 * (X[:, 0] > 0.3) + rng.normal(scale=0.5 + 0.8 * (X[:, 1] > 0), size=n)
+    return X, Y
+
+
+class NormalFixedInit(Normal):
+    """A fixed initialisation, so constant learners take nonzero steps."""
+
+    @staticmethod
+    def fit(Y):
+        return np.array([0.0, 0.0])
+
+
+def _const():
+    return DecisionTreeRegressor(max_depth=2, min_samples_leaf=10_000, random_state=0)
+
+
+def _split():
+    return DecisionTreeRegressor(max_depth=2, min_samples_leaf=10, random_state=0)
+
+
+def _ngb(base, n=40, **kw):
+    return NGBoost(Dist=NormalFixedInit, Score=LogScore, Base=base, n_estimators=n,
+                   learning_rate=0.05, verbose=False, random_state=0, **kw)
+
+
+def _fit_quiet(model, X, Y):
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", NGBoostDegenerateWarning)
+        return model.fit(X, Y)
+
+
+def test_all_constant_model_is_bit_identical_and_learner_free():
+    X, Y = _toy()
+    with pytest.warns(NGBoostDegenerateWarning):
+        m = _ngb(_const(), minibatch_frac=0.7, col_sample=0.5).fit(X, Y)
+    assert np.abs(m.pred_param(X)[0] - m.init_params).max() > 0.1  # the constants carry the fit
+    _bitwise(m.pred_param(X), _loop(m, X))
+    start, steps, _ = m.fold_
+    assert steps == []
+
+
+def test_mixed_per_parameter_learners_bit_identical():
+    X, Y = _toy()
+    m = _ngb([_split(), _const()]).fit(X, Y)
+    _bitwise(m.pred_param(X), _loop(m, X))
+    assert {k for _, k, step in m.fold_[1] if step is None} == {0}
+
+
+def test_trailing_constants_after_a_split_stay_exact():
+    X, Y = _toy()
+    m = _ngb([_split(), _split()], n=30).fit(X, Y)
+    for ms in m.base_models[10:]:
+        for k in range(2):
+            ms[k] = _const().fit(X, np.full(len(X), 0.01 * (k + 1)))
+    assert m.fold_constant_learners() == 40
+    _bitwise(m.pred_param(X), _loop(m, X))
+
+
+def test_max_iter_and_staged_use_the_rounds():
+    X, Y = _toy()
+    m = _fit_quiet(_ngb(_const(), n=20), X, Y)
+    for k in (1, 5, 19):
+        _bitwise(m.pred_param(X, max_iter=k), _loop(m, X, max_iter=k))
+    _bitwise(m.staged_pred_dist(X)[-1]._params, m.pred_dist(X)._params)
+    assert len(m.base_models) == 20
+
+
+def test_refit_and_partial_fit_rebuild_the_fold():
+    X, Y = _toy()
+    X2, Y2 = _toy(seed=1)
+    m = _fit_quiet(_ngb(_const(), n=15), X, Y)
+    _fit_quiet(m, X2, Y2 + 3.0)
+    _bitwise(m.pred_param(X2), _loop(m, X2))
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", NGBoostDegenerateWarning)
+        m.partial_fit(X, Y)
+    assert len(m.base_models) == 30
+    _bitwise(m.pred_param(X), _loop(m, X))
+
+
+def test_pickles_with_and_without_a_plan():
+    X, Y = _toy()
+    m = _fit_quiet(_ngb(_const(), n=15), X, Y)
+    m2 = pickle.loads(pickle.dumps(m))
+    _bitwise(m2.pred_param(X), _loop(m, X))
+    del m2.fold_  # a model pickled by an older version
+    _bitwise(m2.pred_param(X), _loop(m, X))
+    m2.fold_constant_learners()
+    assert m2.fold_ is not None
+
+
+@pytest.mark.parametrize("dist", [Normal, T])
+def test_regressor_with_early_stopping(dist):
+    X, Y = _toy()
+    r = NGBRegressor(Dist=dist, Base=DecisionTreeRegressor(max_depth=2, min_samples_leaf=60),
+                     n_estimators=30, verbose=False, random_state=0, minibatch_frac=0.5,
+                     early_stopping_rounds=3).fit(X, Y)
+    _bitwise(r.pred_param(X), _loop(r, X))
+
+
+@pytest.mark.parametrize("dist,K", [(Bernoulli, 2), (k_categorical(3), 3)])
+def test_classifiers(dist, K):
+    X, Y = _toy()
+    y = np.digitize(Y, np.quantile(Y, np.linspace(0, 1, K + 1)[1:-1]))
+    c = NGBClassifier(Dist=dist, Base=_split(), n_estimators=20, verbose=False, random_state=0).fit(X, y)
+    _bitwise(c.pred_param(X), _loop(c, X))
+
+
+def test_narrow_input_still_rejected():
+    X, Y = _toy()
+    m = _fit_quiet(_ngb(_const(), n=10), X, Y)
+    with pytest.raises((ValueError, IndexError)):
+        m.pred_param(X[:, :2])
+    with pytest.raises(ValueError):
+        m.pred_param(np.where(np.arange(4) == 1, np.inf, X))
+
+
+def test_no_warning_when_trees_split():
+    X, Y = _toy()
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", NGBoostDegenerateWarning)
+        _ngb(_split(), n=5).fit(X, Y)
+
+
+def test_one_row_latency_all_constant():
+    X, Y = _toy()
+    m = _fit_quiet(_ngb(_const(), n=300), X, Y)
+    x = X[:1]
+    old, new = [], []
+    for _ in range(15):
+        t = time.perf_counter()
+        _loop(m, x)
+        old.append(time.perf_counter() - t)
+        t = time.perf_counter()
+        m.pred_param(x)
+        new.append(time.perf_counter() - t)
+    assert np.median(old) / np.median(new) >= 10
